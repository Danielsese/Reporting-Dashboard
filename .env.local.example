# Copy this file to .env.local and fill in the values.

# Supabase project URL — the API URL, NOT the dashboard URL.
# Looks like: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Server-only service-role/secret key (sb_secret_...). NEVER expose to the browser.
# Supabase dashboard → Project Settings → API → Service role / Secret key.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key_here

# The shared access code everyone types to open the dashboard.
APP_PASSCODE=choose-a-code

# Random session token. Generate with:  openssl rand -hex 32
# (Changing it logs everyone out.)
AUTH_TOKEN=generate-a-random-hex-string
